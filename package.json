{
	"name": "obsidian-plugin-intelligence-assistant",
	"version": "0.0.22",
	"description": "Full autonomous Agentic workspace",
	"main": "main.js",
	"scripts": {
		"dev": "node scripts/dev.js",
		"dev:hot": "node scripts/dev.js --hot",
		"dev:watch": "node scripts/dev.js --watch",
		"dev:deploy": "node scripts/dev.js --deploy --local",
		"dev:deploy-prod": "node scripts/dev.js --deploy --production",
		"build": "node scripts/build.js",
		"build:production": "node scripts/build.js --production",
		"build:analyze": "node scripts/build.js --analyze",
		"build:watch": "node scripts/build.js --watch",
		"deploy": "node scripts/deploy.js",
		"deploy:local": "node scripts/deploy.js --local",
		"deploy:production": "node scripts/deploy.js --production",
		"clean": "node scripts/clean.js",
		"lint": "eslint src main.ts packages tests/e2e tests/harness tests/missions tests/perf --ext .ts",
		"lint:fix": "eslint src main.ts packages tests/e2e --ext .ts --fix",
		"type-check": "tsc --noEmit",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"test:e2e": "wdio run tests/e2e/config/wdio.ci.conf.ts",
		"test:e2e:ci": "wdio run tests/e2e/config/wdio.ci.conf.ts",
		"test:e2e:release": "wdio run tests/e2e/config/wdio.release.conf.ts",
		"test:e2e:tour": "wdio run tests/e2e/config/wdio.tour.conf.ts",
		"test:e2e:smoke": "wdio run tests/e2e/config/wdio.ci.conf.ts --spec='tests/e2e/specs/00-smoke.spec.ts'",
		"test:missions": "jest tests/harness tests/missions",
		"test:perf": "jest tests/perf",
		"test:perf:mem": "node --expose-gc node_modules/.bin/jest tests/perf/memory.perf.test.ts",
		"test:mutation": "stryker run",
		"test:flake-soak": "node scripts/flake-soak.js",
		"version": "node scripts/version.js",
		"version:patch": "node scripts/version.js patch",
		"version:minor": "node scripts/version.js minor",
		"version:major": "node scripts/version.js major",
		"hot-reload": "node scripts/hot-reload.js",
		"audit:obsidian-api": "node scripts/obsidian-api-audit.js"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.13",
		"@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
		"@eslint/js": "^9.39.1",
		"@playwright/test": "^1.57.0",
		"@stryker-mutator/core": "^9.6.1",
		"@stryker-mutator/jest-runner": "^9.6.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^24.10.1",
		"@typescript-eslint/eslint-plugin": "8.46.4",
		"@typescript-eslint/parser": "8.46.4",
		"@wdio/cli": "^9.32.0",
		"@wdio/junit-reporter": "^9.32.0",
		"@wdio/local-runner": "^9.32.0",
		"@wdio/mocha-framework": "^9.32.0",
		"@wdio/spec-reporter": "^9.32.0",
		"esbuild": "0.28.1",
		"esbuild-plugin-inline-import": "^1.1.0",
		"eslint": "^9.39.1",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"globals": "^16.5.0",
		"jest": "^30.2.0",
		"jest-environment-jsdom": "^30.2.0",
		"jiti": "^2.6.1",
		"obsidian": "^1.14.4",
		"picocolors": "^1.1.1",
		"playwright": "^1.57.0",
		"ts-jest": "^29.4.5",
		"tslib": "2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "8.46.4",
		"wdio-obsidian-service": "^3.4.0"
	},
	"overrides": {
		"serialize-javascript": "^7.1.4",
		"form-data": "4.0.6",
		"tar": "7.5.22",
		"qs": "6.16.2",
		"brace-expansion@1": "1.1.21",
		"brace-expansion@2": "2.1.7",
		"brace-expansion@>=3": "5.0.12",
		"js-yaml@3": "3.15.2",
		"js-yaml@4": "4.3.2",
		"hono": "4.13.14",
		"@hono/node-server": "2.1.5",
		"fast-uri": "3.1.9",
		"body-parser": "2.4.0",
		"postcss": "8.5.32",
		"ip-address": "10.7.5",
		"ws@7": "7.5.13",
		"undici@6": "6.29.1",
		"undici@>=7": "7.30.1",
		"moment": "2.31.0"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.2",
		"ajv": "^8.20.0",
		"i18next": "^26.2.0",
		"marked": "^17.0.0",
		"zod": "^4.6.7"
	}
}
