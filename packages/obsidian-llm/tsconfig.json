{
	"compilerOptions": {
		"outDir": "dist",
		"rootDir": "src",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"module": "ESNext",
		"target": "ES2020",
		"moduleResolution": "bundler",
		"lib": [
			"DOM",
			"DOM.Iterable",
			"ES2020"
		],
		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"skipLibCheck": true,
		"types": []
	},
	"include": [
		"src/**/*.ts"
	],
	"exclude": [
		"src/__tests__/**"
	]
}
